---
import Base from "../layouts/Base.astro";
import { pi, sections, membersOf, collaborators, alumni } from "../data/people";
import { site } from "../data/site";
import { u } from "../lib/url";

const groups = sections.map((s) => ({ ...s, list: membersOf(s.group) })).filter((s) => s.list.length > 0);
const sinceYear = (since?: string) => (since ? ` since ${since.slice(0, 4)}` : "");
// Until a photo is added, show a plain frame with the person's initials.
const initials = (name: string) => {
  const words = name.split(/\s+/).filter((w) => !/^[A-Z]\.$/.test(w)); // skip lone initials like "B."
  return words[0][0] + (words.length > 1 ? words[words.length - 1][0] : "");
};
---
<Base title="People">
  <h1>People</h1>

  <div class="pi">
    {pi.photo
      ? <img src={u(pi.photo)} alt={pi.name} width="200" height="250" />
      : <div class="ph ph-pi" aria-hidden="true">{initials(pi.name)}</div>}
    <div>
      <h2 style="margin-top:0">{pi.name}</h2>
      <p class="role">{pi.title}</p>
      {pi.bio.map((b) => <p>{b}</p>)}
      <p>
        <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.scholar}>Google Scholar</a>
      </p>
    </div>
  </div>

  {groups.map(({ group, heading, list }) => (
    <section>
      <h2>{heading}</h2>
      <div class="grid-people">
        {list.map((m) => (
          <div class="person">
            {m.photo
              ? <img src={u(m.photo)} alt={m.name} loading="lazy" />
              : <div class="ph" aria-hidden="true">{initials(m.name)}</div>}
            <div class="n">{m.name}</div>
            <div class="r">{m.role}{sinceYear(m.since)}</div>
            {m.affiliation && m.affiliation !== group && <div class="r">{m.affiliation}</div>}
            {m.tagline && <div class="tagline">{m.tagline}</div>}
            {(m.scholar || m.linkedin || m.website) && (
              <div class="plinks">
                {[
                  m.scholar && { href: m.scholar, label: "Scholar" },
                  m.linkedin && { href: m.linkedin, label: "LinkedIn" },
                  m.website && { href: m.website, label: "Website" },
                ].filter(Boolean).map((l, i) => <>{i > 0 && " · "}<a href={l.href}>{l.label}</a></>)}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  ))}

  <h2>Frequent collaborators</h2>
  <ul class="refs">
    {collaborators.map((c) => (
      <li><strong>{c.name}</strong>{c.institution && `, ${c.institution}.`}{c.note && ` ${c.note}`}</li>
    ))}
  </ul>

  <h2>Former members</h2>
  <table class="alumni">
    <thead>
      <tr><th>Name</th><th>Years</th><th>Position in the group</th><th>Later at</th></tr>
    </thead>
    <tbody>
      {alumni.map((a) => (
        <tr><td>{a.name}</td><td>{a.years}</td><td>{a.role}</td><td>{a.later}</td></tr>
      ))}
    </tbody>
  </table>
</Base>
