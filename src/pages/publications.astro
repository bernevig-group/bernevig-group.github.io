---
import Base from "../layouts/Base.astro";
import Ref from "../components/Ref.astro";
import { selectedPapers } from "../lib/papers";
import { site } from "../data/site";

const selected = selectedPapers(10, 5);
---
<Base title="Publications">
  <h1>Publications</h1>
  <p class="note">
    The full list of papers by B. A. Bernevig is on <a href={site.arxivSearch}>arXiv</a> and <a href={site.scholar}>Google Scholar</a>.
  </p>

  <h2>Selected publications</h2>
  <ol class="refs">
    {selected.map((p) => <Ref paper={p} />)}
  </ol>
</Base>
